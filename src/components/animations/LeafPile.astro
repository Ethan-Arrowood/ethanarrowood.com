---
// Canvas falling leaves that pile up along the bottom of the viewport until a
// ghost rakes them away. Runs only while <html data-animation="leaf-pile">.
// See leaf-pile.ts.
---

<canvas class="leaf-pile leaf-pile-back" aria-hidden="true"></canvas>
<canvas class="leaf-pile leaf-pile-front" aria-hidden="true"></canvas>

<style>
	.leaf-pile {
		display: none;
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	/* Falling leaves pass behind the content. */
	.leaf-pile-back {
		z-index: -1;
	}

	/* The pile and the ghost sit in front, along the bottom edge. */
	.leaf-pile-front {
		z-index: 1;
	}

	:global(:root[data-animation="leaf-pile"]) .leaf-pile {
		display: block;
	}

	@media print {
		.leaf-pile {
			display: none !important;
		}
	}
</style>

<script>
	import { LeafPile } from "./leaf-pile";

	const pile = new LeafPile(
		document.querySelector<HTMLCanvasElement>(".leaf-pile-back")!,
		document.querySelector<HTMLCanvasElement>(".leaf-pile-front")!,
	);

	function sync() {
		if (document.documentElement.dataset.animation === "leaf-pile") {
			pile.start();
		} else {
			pile.stop();
		}
	}

	document.addEventListener("site-theme-change", sync);
	sync();
</script>
