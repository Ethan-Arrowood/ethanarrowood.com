---
// Pure CSS falling leaves. Each leaf gets its own position, size, speed, and
// sway from a seeded generator, so builds are deterministic. Only rendered
// visibly when <html data-animation="falling-leaves">.
import { LEAF_COLORS, LEAF_SHAPE_NAMES, leafMaskUrl } from "./leaves";

const LEAF_COUNT = 22;

// mulberry32
function seeded(seed: number) {
	return () => {
		seed |= 0;
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const random = seeded(0x1eaf);
const between = (min: number, max: number) => min + random() * (max - min);
function pick<T>(items: T[]): T {
	return items[Math.floor(random() * items.length)]!;
}

const leaves = Array.from({ length: LEAF_COUNT }, (_, i) => {
	const fall = between(14, 26);
	return {
		style: {
			"--shape": leafMaskUrl(pick(LEAF_SHAPE_NAMES)),
			// Spread leaves evenly across the width, then jitter.
			"--x": `${((i + between(0.1, 0.9)) / LEAF_COUNT) * 100}%`,
			"--size": `${between(14, 30).toFixed(1)}px`,
			"--color": pick(LEAF_COLORS),
			"--fall": `${fall.toFixed(1)}s`,
			// Negative delays start each leaf partway down the screen.
			"--delay": `${(-random() * fall).toFixed(1)}s`,
			"--sway": `${between(20, 70).toFixed(0)}px`,
			"--sway-duration": `${between(2.5, 5).toFixed(1)}s`,
			"--spin": `${between(-220, 220).toFixed(0)}deg`,
			"--spin-duration": `${between(4, 9).toFixed(1)}s`,
		},
	};
});
---

<div class="falling-leaves" aria-hidden="true">
	{leaves.map((leaf) => <span class="leaf" style={leaf.style}>
		<span class="leaf-sway">
			<span class="leaf-body" />
		</span>
	</span>)}
</div>

<style>
	.falling-leaves {
		display: none;
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
	}

	:global(:root[data-animation="falling-leaves"]) .falling-leaves {
		display: block;
	}

	.leaf {
		position: absolute;
		top: 0;
		left: var(--x);
		width: var(--size);
		height: var(--size);
		opacity: 0.55;
		animation: leaf-fall var(--fall) linear var(--delay) infinite;
	}

	.leaf-sway {
		display: block;
		width: 100%;
		height: 100%;
		animation: leaf-sway var(--sway-duration) ease-in-out var(--delay) infinite
			alternate;
	}

	.leaf-body {
		display: block;
		width: 100%;
		height: 100%;
		background-color: var(--color);
		mask: var(--shape) center / contain no-repeat;
		animation: leaf-spin var(--spin-duration) ease-in-out var(--delay) infinite
			alternate;
	}

	@keyframes leaf-fall {
		from {
			transform: translateY(-40px);
		}
		to {
			transform: translateY(calc(100vh + 40px));
		}
	}

	@keyframes leaf-sway {
		from {
			transform: translateX(calc(var(--sway) * -1));
		}
		to {
			transform: translateX(var(--sway));
		}
	}

	@keyframes leaf-spin {
		from {
			transform: rotate(calc(var(--spin) * -0.5)) rotateY(0deg);
		}
		to {
			transform: rotate(var(--spin)) rotateY(160deg);
		}
	}

	@media print {
		.falling-leaves {
			display: none !important;
		}
	}
</style>
